<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>MewUI.Themes.Islands.Demo</RootNamespace>
    <AssemblyName>MewUI.Themes.Islands.Demo</AssemblyName>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- A gallery, not a package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The demo is the one project that chooses MewUI's platform backends. -->
    <PackageReference Include="Aprillz.MewUI" />
    <ProjectReference Include="..\MewUI.Themes.Islands\MewUI.Themes.Islands.csproj" />
  </ItemGroup>

</Project>
